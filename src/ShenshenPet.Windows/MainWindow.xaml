<Window x:Class="ShenshenPet.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="深深桌宠"
        Width="192"
        Height="208"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewMouseLeftButtonDown="OnPetMouseDown"
        PreviewMouseMove="OnPetMouseMove"
        PreviewMouseLeftButtonUp="OnPetMouseUp">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="ProgressMenuItem" Header="白饭 ×3 · 羁绊 Lv.1" IsEnabled="False" />
            <MenuItem Header="领取今日白饭（+3）" Click="OnClaimRiceClick" />
            <MenuItem Header="喂深深一碗白饭" Click="OnFeedClick" />
            <Separator />
            <MenuItem Header="招手" Click="OnWaveClick" />
            <MenuItem Header="状态预览">
                <MenuItem Header="待机" Tag="idle" Click="OnPreviewStateClick" />
                <MenuItem Header="工作中" Tag="running" Click="OnPreviewStateClick" />
                <MenuItem Header="等待输入" Tag="waiting" Click="OnPreviewStateClick" />
                <MenuItem Header="等待检查" Tag="review" Click="OnPreviewStateClick" />
                <MenuItem Header="失败" Tag="failed" Click="OnPreviewStateClick" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="PauseMenuItem" Header="暂停动画" IsCheckable="True" Click="OnPauseClick" />
            <MenuItem x:Name="EnergySaverMenuItem" Header="节能模式（推荐）" IsCheckable="True" Click="OnEnergySaverClick" />
            <MenuItem x:Name="TopmostMenuItem" Header="始终置顶" IsCheckable="True" Click="OnTopmostClick" />
            <MenuItem x:Name="AutoStartMenuItem" Header="开机启动" IsCheckable="True" Click="OnAutoStartClick" />
            <MenuItem Header="大小">
                <MenuItem Header="75%" Tag="0.75" Click="OnScaleClick" />
                <MenuItem Header="100%" Tag="1.0" Click="OnScaleClick" />
                <MenuItem Header="125%" Tag="1.25" Click="OnScaleClick" />
                <MenuItem Header="150%" Tag="1.5" Click="OnScaleClick" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="ActivePackMenuItem" Header="当前角色：深深（内置）" IsEnabled="False" />
            <MenuItem Header="导入 Pet Pack…" Click="OnImportPetPackClick" />
            <MenuItem Header="恢复内置深深" Click="OnRestoreBuiltInPetClick" />
            <Separator />
            <MenuItem Header="安装到 Codex" Click="OnInstallCodexClick" />
            <MenuItem x:Name="InstallBridgeMenuItem" Header="安装 Codex 状态桥接" Click="OnInstallCodexBridgeClick" />
            <MenuItem x:Name="UninstallBridgeMenuItem" Header="卸载 Codex 状态桥接" Click="OnUninstallCodexBridgeClick" />
            <MenuItem Header="隐藏到托盘" Click="OnHideClick" />
            <MenuItem Header="退出" Click="OnExitClick" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Background="Transparent">
        <Image x:Name="PetImage"
               Width="192"
               Height="208"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality"
               IsHitTestVisible="False" />
    </Grid>
</Window>
